{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "inherit",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "PONYTAIL_DEFAULT_MODE": "full",
    "CAVEMAN_DEFAULT_MODE": "off"
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(grep -c *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(brew list *)",
      "Bash(brew info *)",
      "Bash(docker logs *)",
      "Bash(docker stats *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker inspect *)",
      "Bash(docker network ls)",
      "Bash(docker volume ls)",
      "Bash(docker compose ps *)",
      "Read(~/Documents/GitHub/**)",
      "Edit(~/Documents/GitHub/dev_setup/.claude/**)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.git/objects/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/*.lock)",
      "Read(**/*.log)",
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.pgpass)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/application_default_credentials.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/terraform.tfstate*)",
      "Read(**/*.enc.yaml)",
      "Read(**/*.enc.yml)",
      "Read(**/*.enc.json)",
      "Read(/tmp/sops*)",
      "Read(/tmp/op*)",
      "Read(/tmp/bw*)",
      "Read(/tmp/bws*)",
      "Read(/tmp/secret*)",
      "Read(/private/tmp/sops*)",
      "Read(/private/tmp/op*)",
      "Read(/private/tmp/bw*)",
      "Read(/private/tmp/bws*)",
      "Read(/private/tmp/secret*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export *)",
      "Bash(declare)",
      "Bash(declare *)",
      "Bash(op read *)",
      "Bash(bw get *)",
      "Bash(bws secret get *)",
      "Bash(bws secret list *)",
      "Bash(op run --no-masking *)",
      "Bash(echo $*)",
      "Bash(printf *$*)"
    ]
  },
  "model": "opusplan",
  "fallbackModel": [
    "sonnet",
    "haiku"
  ],
  "availableModels": [
    "sonnet",
    "haiku",
    "opus"
  ],
  "hooks": {
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/Documents/GitHub/dev_setup/.claude/scripts/inject-output-style.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "python3 ~/Documents/GitHub/dev_setup/.claude/scripts/block-secret-exposure.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/Documents/GitHub/dev_setup/.claude/scripts/block-secret-exposure.py"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/Documents/GitHub/dev_setup/.claude/scripts/block-secret-exposure.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/no-nested-agents.py"
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "jdtls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "Straight_to_the_Point",
  "feedbackDrafts": "quiet",
  "effortLevel": "medium",
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "editorMode": "normal",
  "skipAutoPermissionPrompt": false
}
